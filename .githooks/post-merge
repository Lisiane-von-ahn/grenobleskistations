#!/usr/bin/env bash
# Post-merge Hook
# Automatically checks and updates dependencies if requirements.txt changed
#
# Place this in: .git/hooks/post-merge
# Make executable: chmod +x .git/hooks/post-merge

# Exit on any error
set -e

# Colors
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Check if requirements.txt was modified in the merge
if git diff-tree -r --name-only HEAD^ HEAD | grep -q "requirements.txt"; then
    echo -e "${YELLOW}📦 requirements.txt has changed${NC}"
    echo "Updating Python dependencies..."
    
    # Try to activate virtual environment if it exists
    if [ -f ".venv/bin/activate" ]; then
        source .venv/bin/activate
    elif [ -f "venv/bin/activate" ]; then
        source venv/bin/activate
    fi
    
    # Update pip and install requirements
    python -m pip install --upgrade pip --quiet
    pip install -r requirements.txt --quiet
    
    echo -e "${GREEN}✓ Dependencies updated${NC}"
fi

# Check if migrations were modified
if git diff-tree -r --name-only HEAD^ HEAD | grep -q "migrations/.*\.py"; then
    echo -e "${YELLOW}🗂️  Migrations have changed${NC}"
    echo "Current migration status:"
    python manage.py showmigrations --compact
fi

exit 0
