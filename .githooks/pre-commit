#!/usr/bin/env bash
# Django Migrations Pre-commit Hook
# Place this file in: .git/hooks/pre-commit
# Make it executable: chmod +x .git/hooks/pre-commit
#
# This hook prevents commits that have unmigrated model changes
# or missing migration files for Django models.

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Checking for unmigrated changes...${NC}"

# Check if there are any Python model changes
MODIFIED_MODELS=$(git diff --cached --name-only | grep -E '(models\.py|migrations/)' || true)

if [ -n "$MODIFIED_MODELS" ]; then
    echo "📝 Modified files: $MODIFIED_MODELS"
    
    # Check for unmigrated changes
    if python manage.py makemigrations --check --noinput 2>/dev/null; then
        echo -e "${GREEN}✓ All database models are properly migrated${NC}"
    else
        echo -e "${RED}❌ ERROR: Unmigrated model changes detected!${NC}"
        echo ""
        echo "📋 Run these commands before committing:"
        echo "   1. python manage.py makemigrations"
        echo "   2. python manage.py migrate"
        echo "   3. git add api/migrations/*.py"
        echo "   4. git commit"
        echo ""
        exit 1
    fi
fi

# Check for migration file syntax
MIGRATION_FILES=$(git diff --cached --name-only | grep 'migrations/.*\.py' || true)
if [ -n "$MIGRATION_FILES" ]; then
    echo "🔎 Checking migration file syntax..."
    
    for file in $MIGRATION_FILES; do
        if [ "$file" != "api/migrations/__init__.py" ]; then
            if ! python -m py_compile "$file" 2>/dev/null; then
                echo -e "${RED}❌ Syntax error in migration: $file${NC}"
                exit 1
            fi
        fi
    done
    
    echo -e "${GREEN}✓ All migration files have valid syntax${NC}"
fi

echo -e "${GREEN}✅ Pre-commit checks passed!${NC}"
exit 0
