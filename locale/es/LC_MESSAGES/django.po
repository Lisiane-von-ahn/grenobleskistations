msgstr "Habitaciones"

msgid "Effacer les filtres"
msgstr "Borrar filtros"

msgid "des pistes"
msgstr "de las pistas"

msgid "Annulation à vérifier"
msgstr "Verificar cancelación"

msgid "Prix indicatif, disponibilité à confirmer"
msgstr "Precio orientativo; confirma disponibilidad"

msgid "Les disponibilités et prix sont vérifiés sur la plateforme choisie."
msgstr "La disponibilidad y los precios se confirman en la plataforma elegida."

msgid "Hôtels et locations"
msgstr "Hoteles y alquileres"

msgid "Maisons et logements uniques"
msgstr "Casas y alojamientos únicos"

msgid "Résultats GrenobleSki correspondant à vos critères."
msgstr "Resultados GrenobleSki según tus criterios."

msgid "Pour voir l’inventaire complet et les disponibilités en temps réel."
msgstr "Consulta todo el inventario y la disponibilidad en tiempo real."
